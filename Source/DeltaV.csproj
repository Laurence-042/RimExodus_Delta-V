<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../build/RimWorldReferences.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>DeltaV</RootNamespace>
    <AssemblyName>DeltaV</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 阶段2 起引入 Harmony（驾驶模式按键抑制）；About.xml 已声明 brrainz.harmony 依赖，运行时用游戏自带 0Harmony。 -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RimExodus.Maps">
      <HintPath>../References/REF/$(RimWorldVersion)/RimExodus.Maps.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireFramework" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('../References/REF/$(RimWorldVersion)/RimExodus.Maps.dll')"
           Text="REF reference missing. Run just build $(RimWorldVersion) to build the sibling framework and fetch its DLL first." />
  </Target>

  <Target Name="CopyExperimental17Content" AfterTargets="Build" Condition="'$(RimWorldVersion)' == '1.7'">
    <ItemGroup>
      <VersionedContent Include="../1.6/**/*" Exclude="../1.6/Assemblies/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(VersionedContent)" DestinationFiles="@(VersionedContent->'../1.7/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
