<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		对接口（2026-09-18 基架归属设计）：门类建筑（Building_DockingPort : Building_Door），
		常闭密封（ExchangeVacuum=false）。rotatable——建造朝向决定对接通道延伸方向；
		需铺在基架上；真空屏障科技解锁。门叶复用原版滑动绘制，通道为常开气密 Portal。
	-->
	<ThingDef ParentName="DoorBase">
		<defName>DeltaV_DockingPort</defName>
		<label>docking port</label>
		<description>A sealed docking airlock. Enable the soft docking guides and align the diamonds to establish a passage between separate ships. Colonists can enter, transfer cargo or hack a locked remote port from this endpoint. Disabling the guides or losing alignment disconnects it. On a shared map it extends a physical force-field passage toward a nearby structure; retracting that passage leaves its contents in place.</description>
		<thingClass>DeltaV.Building_DockingPort</thingClass>
        <comps>
            <li Class="CompProperties">
                <compClass>DeltaV.CompSoftDocking</compClass>
            </li>
            <li Class="CompProperties_Hackable">
                <compClass>DeltaV.CompSoftDockHackable</compClass>
                <defence>1800</defence>
                <effectHacking>HackingTerminal</effectHacking>
                <onlyRemotelyHackable>true</onlyRemotelyHackable>
            </li>
        </comps>
		<designationCategory>Odyssey</designationCategory>
		<rotatable>true</rotatable>
		<stuffCategories Inherit="False" />
		<useStuffTerrainAffordance>false</useStuffTerrainAffordance>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>DeltaV_VacuumBarrier</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>1400</WorkToBuild>
			<MaxHitPoints>200</MaxHitPoints>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Docking/DockingPort_Mover</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Docking/DockingPort_MenuIcon</uiIconPath>
		<building>
			<paintable>false</paintable>
			<blueprintClass>Blueprint_Build</blueprintClass>
			<blueprintGraphicData>
				<texPath>Things/Building/Docking/DockingPort_MenuIcon</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</blueprintGraphicData>
		</building>
		<useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<placeWorkers>
			<li>DeltaV.PlaceWorker_DockingPort</li>
		</placeWorkers>
		<modExtensions>
			<li Class="DeltaV.DefModExtension_DockingPort">
				<channelRange>8</channelRange>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- 仅由对接口生成；不继承 DoorBase 的建造/拆除/禁用操作。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_DockingPassage</defName>
		<label>sealed docking passage</label>
		<description>A retractable deck with vacuum barriers. It belongs to its docking port, not to the ship's substructure.</description>
		<thingClass>DeltaV.Building_DockingChannel</thingClass>
		<category>Building</category>
		<size>(1,1)</size>
		<rotatable>true</rotatable>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<drawerType>RealtimeOnly</drawerType>
		<tickerType>Normal</tickerType>
		<selectable>false</selectable>
		<useHitPoints>true</useHitPoints>
		<fillPercent>0</fillPercent>
		<passability>Standable</passability>
		<surfaceType>Item</surfaceType>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>0</Beauty>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Docking/DockingChannel</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.209,1.258)</drawSize>
			<damageData><enabled>false</enabled></damageData>
		</graphicData>
		<building>
			<isEdifice>true</isEdifice>
			<isInert>true</isInert>
			<canExchangeVacuum>false</canExchangeVacuum>
			<!-- 气密由 Building_DockingChannel.IsAirtight/ExchangeVacuum 按有效端口判定。
			     原版 Def 的 isAirtight 要求 Fillage=Full，不适用于无掩体的力场通道。 -->
			<deconstructible>false</deconstructible>
			<ai_chillDestination>false</ai_chillDestination>
			<paintable>false</paintable>
		</building>
	</ThingDef>

</Defs>
