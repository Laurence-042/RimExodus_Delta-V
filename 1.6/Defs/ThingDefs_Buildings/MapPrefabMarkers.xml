<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 放在导出区域中，每个标记在 prefab 重建后于自身位置生成一名目标派系成员。
		具体 PawnKind 可由此 Comp 单独指定；缺省先取目标派系成员，最后回退 Colonist。
		展开后标记消失。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_PrefabPawnMarker</defName>
		<label>Delta-V prefab pawn marker</label>
		<description>Place this marker in a map prefab to spawn one pawn at this cell when the prefab is built. It uses a member of the destination faction when available, or a colonist otherwise. Humanlike crew receive a vacsuit and helmet. The marker disappears after expansion.</description>
		<thingClass>Building</thingClass>
		<designationCategory>DeltaV_ShipPlanning</designationCategory>
		<placeWorkers><li>DeltaV.PlaceWorker_PrefabMarker</li></placeWorkers>
		<rotatable>false</rotatable>
		<passability>Standable</passability>
		<fillPercent>0.1</fillPercent>
		<uiIconPath>Things/Building/Prefab/PawnMarker</uiIconPath>
		<statBases>
			<WorkToBuild>100</WorkToBuild>
			<MaxHitPoints>50</MaxHitPoints>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Prefab/PawnMarker</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1, 1)</drawSize>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_PrefabPawnSpawner">
				<fallbackPawnKind>Colonist</fallbackPawnKind>
				<fallbackRadius>3</fallbackRadius>
			</li>
		</comps>
	</ThingDef>

	<!-- Registers one child POI marker after its containing prefab has finished rebuilding.
		The child materializes through the normal prefab/lifecycle pipeline when approached. -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_PrefabObjectMarker</defName>
		<label>Delta-V exact prefab object marker</label>
		<description>Configures one prefab-based space object at an exact bearing, distance, and relative facing from this prefab's SpaceObject. Selecting the marker previews the child prefab as a translucent silhouette. The marker disappears after successful expansion.</description>
		<thingClass>Building</thingClass>
		<designationCategory>DeltaV_ShipPlanning</designationCategory>
		<placeWorkers><li>DeltaV.PlaceWorker_PrefabMarker</li></placeWorkers>
		<rotatable>false</rotatable>
		<passability>Standable</passability>
		<fillPercent>0.1</fillPercent>
		<uiIconPath>Things/Building/Prefab/PawnMarker</uiIconPath>
		<statBases>
			<WorkToBuild>100</WorkToBuild>
			<MaxHitPoints>50</MaxHitPoints>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Prefab/PawnMarker</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1, 1)</drawSize>
			<color>(64, 220, 255)</color>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_PrefabObjectSpawner">
				<distance>100</distance>
				<inheritFaction>true</inheritFaction>
			</li>
		</comps>
	</ThingDef>

	<!-- Expands to a deterministic weighted annular cluster of child POI markers. Density is
		objects per 10,000 square universe cells; materialization remains distance-driven. -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_PrefabClusterMarker</defName>
		<label>Delta-V prefab cluster marker</label>
		<description>Configures a weighted prefab pool and an annular distribution to generate asteroid belts, debris fields, or similar clusters. Selecting the marker previews up to 64 generated silhouettes. The marker disappears after successful expansion.</description>
		<thingClass>Building</thingClass>
		<designationCategory>DeltaV_ShipPlanning</designationCategory>
		<placeWorkers><li>DeltaV.PlaceWorker_PrefabMarker</li></placeWorkers>
		<rotatable>false</rotatable>
		<passability>Standable</passability>
		<fillPercent>0.1</fillPercent>
		<uiIconPath>Things/Building/Prefab/PawnMarker</uiIconPath>
		<statBases>
			<WorkToBuild>100</WorkToBuild>
			<MaxHitPoints>50</MaxHitPoints>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Prefab/PawnMarker</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1, 1)</drawSize>
			<color>(255, 184, 51)</color>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_PrefabClusterSpawner">
				<contentTypeId>Asteroid</contentTypeId>
				<innerRadius>80</innerRadius>
				<outerRadius>300</outerRadius>
				<densityPerTenThousand>0.35</densityPerTenThousand>
				<minimumSpacing>20</minimumSpacing>
				<maxObjects>128</maxObjects>
			</li>
		</comps>
	</ThingDef>

    <DesignationCategoryDef>
        <defName>DeltaV_ShipPlanning</defName>
        <label>prefab markers</label>
        <order>790</order>
    </DesignationCategoryDef>

    <ThingDef ParentName="BuildingBase" Name="DeltaV_ShipPlanMarkerBase" Abstract="True">
        <thingClass>Building</thingClass>
        <designationCategory>DeltaV_ShipPlanning</designationCategory>
        <rotatable>false</rotatable>
        <passability>Standable</passability>
        <fillPercent>0.1</fillPercent>
        <uiIconPath>Things/Building/Prefab/PawnMarker</uiIconPath>
        <statBases><WorkToBuild>25</WorkToBuild><MaxHitPoints>50</MaxHitPoints></statBases>
        <graphicData>
            <texPath>Things/Building/Prefab/PawnMarker</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1, 1)</drawSize>
            <color>(132, 233, 156)</color>
        </graphicData>
        <placeWorkers><li>DeltaV.PlaceWorker_ShipPlanMarker</li></placeWorkers>
    </ThingDef>

    <ThingDef ParentName="DeltaV_ShipPlanMarkerBase">
        <defName>DeltaV_ShipPlanner</defName>
        <label>ship layout control</label>
        <description>Place one on an empty connected ship shell. Generate, export, or revert a prefab layout from its commands.</description>
        <destroyable>false</destroyable>
        <building><deconstructible>false</deconstructible></building>
        <comps><li Class="DeltaV.CompProperties_ShipPlanner" /></comps>
    </ThingDef>

    <ThingDef ParentName="DeltaV_ShipPlanMarkerBase">
        <defName>DeltaV_ShipPlanBridge</defName>
        <label>bridge marker</label>
