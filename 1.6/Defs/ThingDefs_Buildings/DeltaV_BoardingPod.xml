<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		跳帮舱发射管（2026-09-21 阶段4）：铺在基架上的单程载人制导飞行器发射器。
		选中殖民者 → gizmo 发射 → 点击目标船外壳（ShellPicking 在 Targeter 内解析）→
		导弹式追踪命中：撞穿外壳开孔、密封舱落位堵孔、乘员在落点旁生成。
		贴图暂用原版门占位（与对接口同策略）。
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_BoardingPodLauncher</defName>
		<label>boarding pod launcher</label>
		<description>A single-use-at-a-time launch tube for manned boarding pods. Select the colonists to deploy, fire the pod at another ship's hull, and the pod will home in like a missile, punch through the outer shell and seal the breach with its own hull. One-way insertion: extract by docking the whole ship or taking the target over.</description>
		<thingClass>DeltaV.Building_BoardingPodLauncher</thingClass>
		<rotatable>false</rotatable>
		<passability>Impassable</passability>
		<fillPercent>0.5</fillPercent>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>DeltaV_VacuumBarrier</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>1600</WorkToBuild>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>0.5</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Door/DoorSimple_Mover</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Door/DoorSimple_MenuIcon</uiIconPath>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
	</ThingDef>

	<!--
		落位跳帮舱（命中产物，不可建造）：门类建筑、常闭密封（ExchangeVacuum=false），
		舱体堵住撞穿的破口，开门通行但不透真空。拆除后破口重新敞开。
	-->
	<ThingDef ParentName="DoorBase">
		<defName>DeltaV_BoardingPodLanded</defName>
		<label>boarding pod (landed)</label>
		<description>The sealed hull of a boarding pod that punched through this ship's outer shell. It plugs the breach it made: walkable when opened, but never exchanges vacuum. Remove it to reopen the hole.</description>
		<thingClass>DeltaV.Building_BoardingPodLanded</thingClass>
		<designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" />
		<stuffCategories Inherit="False" />
		<useStuffTerrainAffordance>false</useStuffTerrainAffordance>
		<statBases>
			<WorkToBuild>800</WorkToBuild>
			<MaxHitPoints>120</MaxHitPoints>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Door/DoorSimple_Mover</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Door/DoorSimple_MenuIcon</uiIconPath>
	</ThingDef>

</Defs>
