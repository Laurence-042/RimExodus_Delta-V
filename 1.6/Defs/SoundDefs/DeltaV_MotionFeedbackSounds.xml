<?xml version="1.0" encoding="utf-8"?>
<!-- Reuses verified Core metal and Odyssey engine grains; no new audio dependency. -->
<Defs>
  <SoundDef>
    <defName>DeltaV_EngineStartMap</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <onCamera>False</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Gravship/Gravship_Engine_Start</clipPath>
          </li>
        </grains>
        <volumeRange>42</volumeRange>
        <pitchRange>0.90~1.00</pitchRange>
        <distRange>12~100</distRange>
      </li>
    </subSounds>
  </SoundDef>
  <SoundDef>
