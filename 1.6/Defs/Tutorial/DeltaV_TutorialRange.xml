<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="DeltaV_RangeTerminalBase" ParentName="AncientTerminalBase" Abstract="True">
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>20</basePowerConsumption>
      </li>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useDuration>90</useDuration>
        <useLabel>Operate shield test terminal</useLabel>
        <compClass>DeltaV.CompUsable_TutorialShieldTerminal</compClass>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_Unshielded</defName>
    <label>1. no-shield reference terminal</label>
    <description>Turn off the target shields to compare weapon impacts on bare armour.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Unshielded</preset>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_KineticHeadOn</defName>
    <label>2. kinetic shield 0 degrees / 35% terminal</label>
    <description>Set the target's kinetic line shield to 0 degrees and 35% strength. Keep firing due east to compare the settings.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Kinetic</preset>
        <angleDeg>0</angleDeg>
        <strengthPercent>35</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_KineticObliqueLow</defName>
    <label>2. kinetic shield 45 degrees / 7% terminal</label>
    <description>Set the target's kinetic line shield to 45 degrees and 7% strength. Keep firing due east to compare the settings.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Kinetic</preset>
        <angleDeg>-45</angleDeg>
        <strengthPercent>7</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_KineticObliqueMedium</defName>
    <label>2. steel and uranium comparison terminal (45 degrees / 35%)</label>
    <description>Set the kinetic line shield to 45 degrees and 35% strength to compare the two heavy cannons.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Kinetic</preset>
        <angleDeg>-45</angleDeg>
        <strengthPercent>35</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_KineticObliqueFull</defName>
    <label>2. kinetic shield 45 degrees / 100% terminal</label>
    <description>Set the target's kinetic line shield to 45 degrees and 100% strength. Keep firing due east to compare the settings.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Kinetic</preset>
        <angleDeg>-45</angleDeg>
        <strengthPercent>100</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_ElectromagneticHeadOn</defName>
    <label>3. electromagnetic shield 0 degrees / 20% terminal</label>
    <description>Set the target's electromagnetic line shield to 0 degrees and 20% strength. Keep firing due east to compare the settings.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Electromagnetic</preset>
        <angleDeg>0</angleDeg>
        <strengthPercent>20</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_ElectromagneticObliqueLow</defName>
    <label>3. electromagnetic shield 45 degrees / 20% terminal</label>
    <description>Set the target's electromagnetic line shield to 45 degrees and 20% strength. Keep firing due east to compare the settings.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Electromagnetic</preset>
        <angleDeg>-45</angleDeg>
        <strengthPercent>20</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_ElectromagneticObliqueMedium</defName>
    <label>3. electromagnetic shield 45 degrees / 50% terminal</label>
    <description>Set the target's electromagnetic line shield to 45 degrees and 50% strength. Watch the eastbound laser turn back toward the front of the shield.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Electromagnetic</preset>
        <angleDeg>-45</angleDeg>
        <strengthPercent>50</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_ElectromagneticObliqueFull</defName>
    <label>3. electromagnetic shield 45 degrees / 100% terminal</label>
    <description>Set the target's electromagnetic line shield to 45 degrees and 100% strength. Keep firing due east to compare the settings.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Electromagnetic</preset>
        <angleDeg>-45</angleDeg>
        <strengthPercent>100</strengthPercent>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_GuardSingle</defName>
    <label>4. single guard shield terminal</label>
    <description>Enable the target's primary guard shield for the single-emitter test.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>GuardSingle</preset>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_Guard</defName>
    <label>4. joint guard shield terminal</label>
    <description>Enable the target's three guard shields for a shared-capacity test.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialShieldTerminal">
        <preset>Guard</preset>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="DeltaV_RangeTerminalBase">
    <defName>DeltaV_RangeTerminal_Introduction</defName>
    <label>0. range instructions terminal</label>
    <description>Read the operating and safety instructions, then acknowledge them to unlock the allied blast door. You can return to read the instructions again.</description>
    <comps>
      <li Class="DeltaV.CompProperties_TutorialRangeBriefing" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="DoorBase">
    <defName>DeltaV_RangeBlastDoor</defName>
    <label>range safety blast door</label>
    <description>An allied blast door protecting the test platform entrance. Read and acknowledge the instructions on the entrance terminal to unlock it.</description>
    <thingClass>Building_HackableDoor</thingClass>
    <designationCategory IsNull="True" />
    <graphicData>
      <texPath>Things/Building/Ancient/BlastDoor/AncientBlastDoor_Mover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Ancient/BlastDoor/AncientBlastDoor_MenuIcon_south</uiIconPath>
    <statBases>
      <MaxHitPoints>6000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <rotatable>true</rotatable>
    <building>
      <paintable>false</paintable>
      <deconstructible>false</deconstructible>
      <neverBuildable>true</neverBuildable>
      <unpoweredDoorOpenSpeedFactor>1.2</unpoweredDoorOpenSpeedFactor>
      <isAirtight>true</isAirtight>
      <draftAttackNonDeconstructable>false</draftAttackNonDeconstructable>
      <isSupportDoor>true</isSupportDoor>
      <doorTopGraphic>
        <texPath>Things/Building/Ancient/BlastDoor/AncientBlastDoor_Top</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2,2.2)</drawSize>
      </doorTopGraphic>
      <doorTopHorizontalOffset>(0,0,0.05)</doorTopHorizontalOffset>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <stuffCategories Inherit="False" />
    <costStuffCount>0</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Hackable">
        <defence>1800</defence>
        <effectHacking>HackingTerminal</effectHacking>
        <lockoutDurationHoursRange>2~3</lockoutDurationHoursRange>
        <notHackedInspectString>Read the entrance terminal instructions to unlock.</notHackedInspectString>
        <hackedInspectString>Safety instructions acknowledged. Unlocked.</hackedInspectString>
        <hackedMessage>{HACKER_labelShort} has finished hacking {SUBJECT_labelNoParenthesisDef}.</hackedMessage>
        <showProgressAfterHackCompletion>false</showProgressAfterHackCompletion>
        <unhackedGraphicData>
          <texPath>Things/Building/Ancient/BlastDoor/AncientBlastDoor_HackingTerminal</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
        </unhackedGraphicData>
        <unhackedGraphicOffset>(0,0.05,0)</unhackedGraphicOffset>
        <graphicDrawerType>RealtimeOnly</graphicDrawerType>
        <onlyRemotelyHackable>true</onlyRemotelyHackable>
      </li>
    </comps>
  </ThingDef>
</Defs>
