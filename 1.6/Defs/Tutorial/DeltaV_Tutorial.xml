<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ScenPartDef>
    <defName>DeltaV_TutorialArrival</defName>
    <label>awaken at the orbital colony</label>
    <category>Fixed</category>
    <scenPartClass>DeltaV.ScenPart_DeltaVTutorialArrival</scenPartClass>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
    <canBePlayerAddedRemoved>false</canBePlayerAddedRemoved>
    <maxUses>1</maxUses>
  </ScenPartDef>
  <MapGeneratorDef ParentName="SpaceMapGenerator">
    <defName>DeltaV_TutorialStation</defName>
    <label>orbital arrival station</label>
    <genSteps Inherit="False">
      <li>Space</li>
      <li>DeltaV_TutorialStation</li>
      <li>ScenParts</li>
      <li>FogSpace</li>
    </genSteps>
  </MapGeneratorDef>
  <GenStepDef>
    <defName>DeltaV_TutorialStation</defName>
    <order>200</order>
    <genStep Class="DeltaV.GenStep_DeltaVTutorialStation" />
  </GenStepDef>
  <QuestScriptDef>
    <defName>DeltaV_ColonistTraining</defName>
    <label>an orbital beginning</label>
    <root Class="DeltaV.QuestNode_Root_DeltaVTutorial" />
    <autoAccept>true</autoAccept>
    <randomlySelectable>false</randomlySelectable>
    <sendAvailableLetter>false</sendAvailableLetter>
    <endOnColonyMove>false</endOnColonyMove>
    <everAcceptableInSpace>true</everAcceptableInSpace>
  </QuestScriptDef>
  <FactionDef ParentName="OutlanderFactionBase">
    <defName>DeltaV_OrbitalPioneers</defName>
    <label>Starbound</label>
    <description>An orbital organization that rescued the damaged colony ship and took its computer core as payment. They offer flight instruction and a prototype research ship.</description>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <basicMemberKind>Villager</basicMemberKind>
    <layerWhitelist>
      <li>Orbit</li>
    </layerWhitelist>
  </FactionDef>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>DeltaV_OrbitalColonists</defName>
    <label>Orbital colonists</label>
    <description>Your colony ship reached its destination, but lost its stern and computer core in an attack. You alone are awake. Contact Starbound from the trainer outside the airlock, learn what happened, and prepare for life in space.</description>
    <scenario>
      <summary>One captain awakens in the cargo compartment of a looted colony ship. Five fellow colonists remain in cryptosleep.</summary>
      <playerFaction>
        <factionDef>GravshipCrew</factionDef>
      </playerFaction>
      <parts Inherit="False">
        <li Class="ScenPart_PlanetLayer">
          <def>PlanetLayerFixed</def>
          <tag>Orbit</tag>
          <layer>Orbit</layer>
          <settingsDef>Orbit</settingsDef>
          <hide>true</hide>
          <connections>
            <Surface>
              <zoomMode>ZoomIn</zoomMode>
            </Surface>
          </connections>
        </li>
        <li Class="DeltaV.ScenPart_ConfigPage_TutorialColonists">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>1</pawnCount>
          <pawnChoiceCount>6</pawnChoiceCount>
          <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
        </li>
        <li Class="ScenPart_ForcedMap">
          <def>ForcedMap</def>
          <mapGenerator>DeltaV_TutorialStation</mapGenerator>
          <layerDef>Orbit</layerDef>
        </li>
        <li Class="DeltaV.ScenPart_DeltaVTutorialArrival">
          <def>DeltaV_TutorialArrival</def>
        </li>
        <li Class="ScenPart_CreateQuest">
          <def>CreateQuest</def>
          <questDef>DeltaV_ColonistTraining</questDef>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>BasicGravtech</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>OrbitalTech</project>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
