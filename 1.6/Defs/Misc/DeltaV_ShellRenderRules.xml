<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <!--
    外壳 Thing 规则。实心结构自动包含；规则可纳入非实心建筑或排除内部部件。
    render 将贴图来源、表面层级、替代 GraphicData 与 zIndex 放在一起。
    Hull 是普通船壳，Exposed 在整片船壳上方；zIndex 单位为一个 AltInc。
    alternateGraphics 是按顺序绘制的整组替换图；未设置时复用建筑的原版多层绘制。
    TurretTop 来源只允许一张替换图，尺寸仍取 turretTopDrawSize。

    示例：
    <render>
      <source>Thing</source><layer>Hull</layer>
      <alternateGraphics>
        <li><graphicClass>Graphic_Multi</graphicClass><texPath>MyMod/Things/Lower</texPath><drawSize>(2.2,2.2)</drawSize></li>
        <li><graphicClass>Graphic_Single</graphicClass><texPath>MyMod/Things/Upper</texPath><drawSize>(2.2,2.2)</drawSize><drawOffset>(0,0.03,0)</drawOffset></li>
      </alternateGraphics>
    </render>
  -->
  <DeltaV.ShellRenderRuleDef>
    <defName>DeltaV_Shell_LargeThruster</defName>
    <thingDef>LargeThruster</thingDef>
    <render><zIndex>1</zIndex></render>
  </DeltaV.ShellRenderRuleDef>

  <!-- 顶部炮塔只把旋转炮身画在船壳表面；底座和覆盖插件不进入外壳。 -->
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_PDTurret</defName><thingDef>DeltaV_Weapon_PDTurret</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_CannonTurret</defName><thingDef>DeltaV_Weapon_CannonTurret</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_RapidTurret</defName><thingDef>DeltaV_Weapon_RapidMainSmall</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_LaserTurret</defName><thingDef>DeltaV_Weapon_LaserTurret</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_HeavyMainMedium</defName><thingDef>DeltaV_Weapon_HeavyMainMedium</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_RapidMainMedium</defName><thingDef>DeltaV_Weapon_RapidMainMedium</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_LaserMainMedium</defName><thingDef>DeltaV_Weapon_LaserMainMedium</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>

  <!-- 护盾头与炮塔共用顶部入口；守卫圆盾由拦截器的 PostDraw 单独采集。 -->
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_ShieldGenerator</defName><thingDef>DeltaV_ShieldGenerator</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_ShieldGeneratorSmall</defName><thingDef>DeltaV_ShieldGeneratorSmall</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>

  <!-- 装弹机在船内；加速段的内构与外壳按原版多层绘制进入船壳。 -->
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_HideRailgunLoader</defName><thingDef>DeltaV_Weapon_RailgunLoader</thingDef><exclude>true</exclude></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_RailgunAccelerator</defName><thingDef>DeltaV_Weapon_RailgunAccelerator</thingDef><render><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>

  <!-- Interior port / exterior raised cargo box share one inventory and footprint. -->
  <DeltaV.ShellRenderRuleDef Name="DeltaVCargoShell" Abstract="True">
    <render>
      <layer>Exposed</layer><shadowHeight>1.1</shadowHeight>
      <alternateGraphics><li>
        <texPath>Things/Building/StationTrade/CargoExterior</texPath>
        <graphicClass>DeltaV.Graphic_SpaceCargo</graphicClass><shaderType>CutoutComplex</shaderType>
        <drawSize>(2.2730,3.0316)</drawSize><damageData><enabled>false</enabled></damageData>
      </li></alternateGraphics>
    </render>
  </DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef ParentName="DeltaVCargoShell"><defName>DeltaV_Shell_CargoSealed</defName><thingDef>DeltaV_CargoContainer</thingDef></DeltaV.ShellRenderRuleDef>
  <DeltaV.ShellRenderRuleDef ParentName="DeltaVCargoShell"><defName>DeltaV_Shell_CargoStorage</defName><thingDef>DeltaV_CargoStorage</thingDef></DeltaV.ShellRenderRuleDef>
</Defs>
