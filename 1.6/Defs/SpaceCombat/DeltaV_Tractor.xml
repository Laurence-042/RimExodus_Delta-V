<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="DeltaV_EngineeringTurret">
    <defName>DeltaV_TractorBeam</defName>
    <researchPrerequisites Inherit="False"><li>BasicGravtech</li><li>OrbitalTech</li></researchPrerequisites>
    <costList Inherit="False"><Steel>150</Steel><Plasteel>30</Plasteel><ComponentIndustrial>6</ComponentIndustrial></costList>
    <statBases><WorkToBuild>8000</WorkToBuild></statBases><label>tractor beam</label><uiOrder>2102</uiOrder>
    <description>An engineering device built on a moonpool. Requires power and stored electricity. Assigned to secondary group 4 by default.\n\nCollect items: select “Current mode: Collect items” and enable its weapon group. It automatically recovers drifting items and living pawns near the moonpool according to the cargo and living-pawn filters. Disabling the group stops collection; manual fire control is not required. Living pawns have a separate toggle, with hostiles excluded by default. Each target is reserved for one tractor. Leave room near the moonpool for deliveries.\n\nPull structures: select “Current mode: Pull structures”, enable its group, and hold the corresponding fire button in manual fire control (right mouse button for the default secondary group). The beam fires along the barrel and pulls structures it hits within range; the cursor sets the direction and need not be on the target. Automatic fire control never operates structural towing. Disconnected components separate before force is applied; the target needs no engine. Each beam provides one quarter of a large thruster’s full thrust. Multiple beams add force, and the firing ship receives the reaction force.\n\nFor stable towing, aim the beam’s line of force through the target’s center of mass and use an inertia coupler to reduce relative rotation. Off-center towing turns the target.</description>
    <size>(1,1)</size><passability>Standable</passability>
    <uiIconPath>Things/Building/SpaceWeapons/TractorBeam_MenuIcon</uiIconPath>
    <graphicData><drawSize>(1.3,1.3)</drawSize></graphicData>
    <building><turretTopDrawSize>1.2</turretTopDrawSize><blueprintGraphicData><texPath>Things/Building/SpaceWeapons/TractorBeam_MenuIcon</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>EdgeDetect</shaderType><drawSize>(1.3,1.3)</drawSize></blueprintGraphicData></building>
    <placeWorkers><li>DeltaV.PlaceWorker_SpaceTractor</li></placeWorkers>
    <inspectorTabs><li>DeltaV.ITab_TractorCargo</li></inspectorTabs>
    <comps>
      <li Class="DeltaV.CompProperties_SpaceWeapon">
        <manualOnly>true</manualOnly><tractor>true</tractor><aimMode>PointDefense</aimMode>
        <projectileDef>DeltaV_Beam_Tractor</projectileDef><intrinsicAimSkill>20</intrinsicAimSkill><baseSpreadDeg>0</baseSpreadDeg>
        <cooldownTicks>1</cooldownTicks><range>60</range><shotEnergy>0.05</shotEnergy>
        <defaultSalvoSet>Secondary</defaultSalvoSet><defaultGroupNumber>4</defaultGroupNumber>
        <topTurret>true</topTurret><turretMuzzleDistance>0</turretMuzzleDistance><defaultFireDeviationDeg>2</defaultFireDeviationDeg>
      </li>
      <li Class="DeltaV.CompProperties_SpaceTractor"/>
    </comps>
    <modExtensions><li Class="DeltaV.DefModExtension_SpaceTurretArt"><topTexPath>Things/Building/SpaceWeapons/TractorBeam_Top</topTexPath></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="DeltaV_EngineeringBeam">
    <defName>DeltaV_Beam_Tractor</defName><label>tractor beam</label>
    <comps><li Class="DeltaV.CompProperties_SpaceProjectile">
      <hasMap>false</hasMap><collisionRadius>0</collisionRadius><speed>2000</speed><laserRange>60</laserRange><laserBeamWidth>0.18</laserBeamWidth>
      <continuousBeam>true</continuousBeam><ignoresShields>true</ignoresShields><visualStyle>Tractor</visualStyle>
      <fireSoundMap>DeltaV_FireLaserMap</fireSoundMap><fireSoundShell>DeltaV_FireLaserShell</fireSoundShell>
    </li></comps>
  </ThingDef>
  <DeltaV.SpaceImpactEffectDef Name="DeltaV_TractorImpact" Abstract="True">
    <projectileDefs><li>DeltaV_Beam_Tractor</li></projectileDefs><buildingHitChance>1</buildingHitChance>
    <defenderEffect><kind>TractorPull</kind><tractorForce>500</tractorForce></defenderEffect>
    <attackerEffect><kind>DestroySelf</kind></attackerEffect>
  </DeltaV.SpaceImpactEffectDef>
  <DeltaV.SpaceImpactEffectDef ParentName="DeltaV_TractorImpact"><defName>DeltaV_Impact_TractorStructure</defName></DeltaV.SpaceImpactEffectDef>
  <DeltaV.SpaceImpactEffectDef ParentName="DeltaV_TractorImpact"><defName>DeltaV_Impact_TractorFoundation</defName><targetsSubstructure>true</targetsSubstructure><substructureHitChance>1</substructureHitChance></DeltaV.SpaceImpactEffectDef>
  <DeltaV.ShellRenderRuleDef><defName>DeltaV_Shell_TractorBeam</defName><thingDef>DeltaV_TractorBeam</thingDef><render><source>TurretTop</source><layer>Exposed</layer></render></DeltaV.ShellRenderRuleDef>
</Defs>
