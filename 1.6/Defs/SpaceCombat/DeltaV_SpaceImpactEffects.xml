<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		联合效果注册表默认条目（太空战架构 §3.4，用户定案示例；效果数值
		可在此调参）。命中判定先按目标类型执行：
		墙恒中，其他建筑按 fillPercent，基架固定 50%，点防专用弹体对导弹恒中。
		未命中时弹体穿过，下一候选可继续判定。然后执行本表的命中后效：
		- 命中后效：attackerEffect（弹体一侧）与 defenderEffect（被撞容器一侧）
		  各自解析执行（对称结算，§3.5）。
		匹配链：精确 def 对 → 该弹体 × 基架 → 该弹体 × 任意目标 → 全局兜底
		（最后一条，两列表空 = 同等耐久舱壁规则，伤害按基准耐久/守方耐久缩放）。
	-->

	<!-- 直射弹 × 舱壁/任意实心建筑：伤害随相对速度/入射角；高耐久 ∧ 斜入射跳弹（消灭无伤）。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_CannonVsStructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Cannon</li>
		</projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>22</damage>
			<referenceSpeed>60</referenceSpeed>
			<speedExponent>1</speedExponent>
			<incidenceMinFactor>0.35</incidenceMinFactor>
			<armorPenetration>12</armorPenetration>
			<explosionRadius>0</explosionRadius>
			<penetrationLayers>
				<li><damageFactor>3.5</damageFactor><halfWidth>1</halfWidth></li>
				<li><damageFactor>1.6</damageFactor></li>
				<li><damageFactor>0.8</damageFactor></li>
			</penetrationLayers>
			<ricochetMinHitPoints>250</ricochetMinHitPoints>
			<ricochetMinIncidenceDeg>60</ricochetMinIncidenceDeg>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 速射弹单格点射，不继承重炮的宽弹孔与穿层。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_RapidVsStructure</defName>
		<projectileDefs><li>DeltaV_Projectile_Rapid</li></projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind><damageDef>Bullet</damageDef>
			<damage>22</damage><referenceSpeed>60</referenceSpeed><speedExponent>1</speedExponent>
			<incidenceMinFactor>0.35</incidenceMinFactor><armorPenetration>12</armorPenetration>
		</defenderEffect>
		<attackerEffect><kind>DestroySelf</kind></attackerEffect>
	</DeltaV.SpaceImpactEffectDef>
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_RapidVsSubstructure</defName>
		<projectileDefs><li>DeltaV_Projectile_Rapid</li></projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect><kind>DamageMap</kind><damageDef>Bullet</damageDef><damage>7</damage></defenderEffect>
		<attackerEffect><kind>DestroySelf</kind></attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 直射弹 × 基架：固定概率放行；后效 = 命中位爆炸 + 递减摧毁基架 + 破片溅射。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_CannonVsSubstructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Cannon</li>
		</projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>18</damage>
			<referenceSpeed>60</referenceSpeed>
			<speedExponent>1</speedExponent>
			<incidenceMinFactor>0.5</incidenceMinFactor>
			<armorPenetration>8</armorPenetration>
			<explosionRadius>1.8</explosionRadius>
			<stripSubstructureRadius>2.5</stripSubstructureRadius>
			<stripSubstructureChance>0.6</stripSubstructureChance>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 激光 × 舱壁/任意实心建筑：高频直击（hitscan 无速度缩放语义），仅按入射角衰减。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_LaserVsStructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Laser</li>
		</projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bullet</damageDef>
			<damage>12</damage>
			<incidenceMinFactor>0.5</incidenceMinFactor>
			<armorPenetration>16</armorPenetration>
			<explosionRadius>0</explosionRadius>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 激光 × 基架：固定伤害（摧毁命中格基架）。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_LaserVsSubstructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Laser</li>
		</projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bullet</damageDef>
			<damage>10</damage>
			<explosionRadius>0</explosionRadius>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 重激光 × 舱壁：基础直击量由武器 impactScale 放大；无速度缩放语义。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_LaserHeavyVsStructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_LaserHeavy</li>
		</projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bullet</damageDef>
			<damage>12</damage>
			<incidenceMinFactor>0.5</incidenceMinFactor>
			<armorPenetration>15</armorPenetration>
			<explosionRadius>0</explosionRadius>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 重激光 × 基架：固定伤害（摧毁命中格基架）。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_LaserHeavyVsSubstructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_LaserHeavy</li>
		</projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bullet</damageDef>
			<damage>10</damage>
			<explosionRadius>0</explosionRadius>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 高爆导弹 × 舱壁：化学战斗部不随撞击速度衰减，单发可击毁 420 HP 基础舱壁。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_MissileVsStructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Missile</li>
		</projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>450</damage>
			<speedExponent>0</speedExponent>
			<incidenceMinFactor>1</incidenceMinFactor>
			<armorPenetration>8</armorPenetration>
			<explosionRadius>1.6</explosionRadius>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 高爆导弹 × 基架：固定概率触发爆炸；威力不随撞击速度衰减。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_MissileVsSubstructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Missile</li>
		</projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>450</damage>
			<speedExponent>0</speedExponent>
			<incidenceMinFactor>1</incidenceMinFactor>
			<armorPenetration>6</armorPenetration>
			<explosionRadius>2.2</explosionRadius>
			<stripSubstructureRadius>3</stripSubstructureRadius>
			<stripSubstructureChance>0.7</stripSubstructureChance>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 护盾后破片：能量比例由弹体服务带入 damageScale。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_ShieldFragmentVsStructure</defName>
		<projectileDefs><li>DeltaV_Projectile_ShieldFragment</li><li>DeltaV_Projectile_RailFragment</li></projectileDefs>
		<defenderEffect><kind>DamageMap</kind><damageDef>Bullet</damageDef>
			<damage>12</damage><speedExponent>0</speedExponent><incidenceMinFactor>1</incidenceMinFactor>
			<armorPenetration>4</armorPenetration></defenderEffect>
		<attackerEffect><kind>DestroySelf</kind></attackerEffect>
	</DeltaV.SpaceImpactEffectDef>
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_ShieldFragmentVsSubstructure</defName>
		<projectileDefs><li>DeltaV_Projectile_ShieldFragment</li><li>DeltaV_Projectile_RailFragment</li></projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect><kind>DamageMap</kind><damageDef>Bullet</damageDef><damage>8</damage></defenderEffect>
		<attackerEffect><kind>DestroySelf</kind></attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 点防激光 × 任意实体：三次命中可击毁当前 25 HP 高爆导弹。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_PdLaserVsStructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_PDLaser</li>
		</projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bullet</damageDef>
			<damage>10</damage>
			<speedExponent>0</speedExponent>
			<incidenceMinFactor>1</incidenceMinFactor>
			<armorPenetration>4</armorPenetration>
			<explosionRadius>0</explosionRadius>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 点防激光 × 基架：局部熔蚀。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_PdLaserVsSubstructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_PDLaser</li>
		</projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bullet</damageDef>
			<damage>8</damage>
			<speedExponent>0</speedExponent>
			<explosionRadius>0</explosionRadius>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 轨道炮弹 × 舱壁：高穿深直伤（链倍率随弹体携带，段6）。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_RailgunVsStructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_RailgunSlug</li>
		</projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>55</damage>
			<referenceSpeed>120</referenceSpeed>
			<speedExponent>1</speedExponent>
			<incidenceMinFactor>0.6</incidenceMinFactor>
			<armorPenetration>60</armorPenetration>
			<explosionRadius>0</explosionRadius>
			<penetrationLayers>
				<li><damageFactor>2.4</damageFactor></li>
				<li><damageFactor>2.2</damageFactor></li>
				<li><damageFactor>2</damageFactor></li>
				<li><damageFactor>1.6</damageFactor></li>
				<li><damageFactor>1.2</damageFactor></li>
				<li><damageFactor>0.8</damageFactor></li>
			</penetrationLayers>
			<ricochetMinHitPoints>600</ricochetMinHitPoints>
			<ricochetMinIncidenceDeg>70</ricochetMinIncidenceDeg>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 轨道炮弹 × 基架：统一 50% 命中，高动能贯穿破片。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_RailgunVsSubstructure</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_RailgunSlug</li>
		</projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>40</damage>
			<referenceSpeed>120</referenceSpeed>
			<speedExponent>1</speedExponent>
			<incidenceMinFactor>0.6</incidenceMinFactor>
			<armorPenetration>45</armorPenetration>
			<explosionRadius>1.2</explosionRadius>
			<stripSubstructureRadius>2</stripSubstructureRadius>
			<stripSubstructureChance>0.5</stripSubstructureChance>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 动能弹与侵入舱 × 护盾弧：有容量即截获；不足时留下降速弹体。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_VsShield</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Cannon</li>
			<li>DeltaV_Projectile_Rapid</li>
			<li>DeltaV_Projectile_RailgunSlug</li>
			<li>DeltaV_ShuttleBoarding</li>
			<li>DeltaV_Projectile_ShieldFragment</li>
		</projectileDefs>
		<targetThingDefs>
			<li>GravshipShieldGenerator</li>
		</targetThingDefs>
		<defenderEffect>
			<kind>ShieldDrain</kind>
			<damage>25</damage>
			<referenceSpeed>60</referenceSpeed>
			<speedExponent>1</speedExponent>
			<incidenceMinFactor>0.5</incidenceMinFactor>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 高爆战斗部的盾耗由化学载荷决定，不按撞击速度缩小。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_MissileVsShield</defName>
		<projectileDefs><li>DeltaV_Projectile_Missile</li></projectileDefs>
		<targetThingDefs><li>GravshipShieldGenerator</li></targetThingDefs>
		<defenderEffect><kind>ShieldDrain</kind><damage>450</damage>
			<speedExponent>0</speedExponent><incidenceMinFactor>1</incidenceMinFactor></defenderEffect>
		<attackerEffect><kind>DestroySelf</kind></attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 即时激光没有弹速，护盾消耗不得乘相对速度。中型炮的 impactScale 同时作用于该值。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_LaserVsShield</defName>
		<projectileDefs>
			<li>DeltaV_Projectile_Laser</li>
			<li>DeltaV_Projectile_LaserHeavy</li>
			<li>DeltaV_Projectile_PDLaser</li>
		</projectileDefs>
		<targetThingDefs>
			<li>GravshipShieldGenerator</li>
		</targetThingDefs>
		<defenderEffect>
			<kind>ShieldDrain</kind>
			<damage>12</damage>
			<speedExponent>0</speedExponent>
			<incidenceMinFactor>1</incidenceMinFactor>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 侵入 shuttle × 船壳/基架（§7.5）：攻方后效 = 放置（舱体放撞击位内侧，服务回调）；
	     守方后效 = 撞击毁伤（数值 §15.9 默认）。命中判定恒产生后效。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_BoardingVsStructure</defName>
		<projectileDefs>
			<li>DeltaV_ShuttleBoarding</li>
		</projectileDefs>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>45</damage>
			<referenceSpeed>60</referenceSpeed>
			<speedExponent>0.5</speedExponent>
			<incidenceMinFactor>0.6</incidenceMinFactor>
			<armorPenetration>30</armorPenetration>
			<explosionRadius>2.4</explosionRadius>
			<stripSubstructureRadius>2</stripSubstructureRadius>
			<stripSubstructureChance>0.8</stripSubstructureChance>
		</defenderEffect>
		<attackerEffect>
			<kind>PlaceBody</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_BoardingVsSubstructure</defName>
		<projectileDefs>
			<li>DeltaV_ShuttleBoarding</li>
		</projectileDefs>
		<targetsSubstructure>true</targetsSubstructure>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bomb</damageDef>
			<damage>35</damage>
			<referenceSpeed>60</referenceSpeed>
			<speedExponent>0.5</speedExponent>
			<incidenceMinFactor>0.6</incidenceMinFactor>
			<armorPenetration>20</armorPenetration>
			<explosionRadius>2.0</explosionRadius>
			<stripSubstructureRadius>2</stripSubstructureRadius>
			<stripSubstructureChance>0.8</stripSubstructureChance>
		</defenderEffect>
		<attackerEffect>
			<kind>PlaceBody</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

	<!-- 全局兜底（两列表空）：同等耐久舱壁规则——伤害随相对速度/入射角、
	     耐久只换参数（基准 100 耐久，按守方耐久缩放）、满足跳弹条件跳弹。 -->
	<DeltaV.SpaceImpactEffectDef>
		<defName>DeltaV_Impact_FallbackWall</defName>
		<fallbackBaselineHitPoints>100</fallbackBaselineHitPoints>
		<defenderEffect>
			<kind>DamageMap</kind>
			<damageDef>Bullet</damageDef>
			<damage>20</damage>
			<referenceSpeed>60</referenceSpeed>
			<speedExponent>1</speedExponent>
			<incidenceMinFactor>0.35</incidenceMinFactor>
			<armorPenetration>10</armorPenetration>
			<explosionRadius>0</explosionRadius>
			<ricochetMinHitPoints>250</ricochetMinHitPoints>
			<ricochetMinIncidenceDeg>60</ricochetMinIncidenceDeg>
		</defenderEffect>
		<attackerEffect>
			<kind>DestroySelf</kind>
		</attackerEffect>
	</DeltaV.SpaceImpactEffectDef>

</Defs>
