<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>DeltaV_Projectile_Cannon</defName>
    <label>cannon shot</label>
    <description>Test projectile: a slow heavy shell flying straight in the universe layer.</description>
    <thingClass>Verse.Building</thingClass>
    <category>Building</category>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>0.4</fillPercent>
    <size>(1,1)</size>
    <designationCategory Inherit="False" />
    <researchPrerequisites Inherit="False" />
    <stuffCategories Inherit="False" />
    <statBases>
      <WorkToBuild>1</WorkToBuild>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Projectile/ShellHighExplosive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.4,1.4)</drawSize>
      <shaderType>Cutout</shaderType>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <comps>
      <li Class="DeltaV.CompProperties_SpaceProjectile">
        <visualStyle>Heavy</visualStyle>
        <tracerLength>1.5</tracerLength>
        <tracerWidth>0.14</tracerWidth>
        <fireSoundMap>DeltaV_FireHeavyMap</fireSoundMap>
        <fireSoundShell>DeltaV_FireHeavyShell</fireSoundShell>
        <impactSoundMap>DeltaV_ImpactHeavyMap</impactSoundMap>
        <impactSoundShell>DeltaV_ImpactHeavyShell</impactSoundShell>
        <speed>60</speed>
        <timeoutTicks>900</timeoutTicks>
        <hasMap>false</hasMap>
        <shieldFragmentCost>2</shieldFragmentCost>
        <shieldFragmentDef>DeltaV_Projectile_ShieldFragment</shieldFragmentDef>
        <shieldTumbleDef>DeltaV_Projectile_ShellTumbling</shieldTumbleDef>
        <shieldFragmentCount>3</shieldFragmentCount>
        <shieldFragmentScatterDeg>11</shieldFragmentScatterDeg>
      </li>
    </comps>
  </ThingDef>
