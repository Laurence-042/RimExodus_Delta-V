<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		阶段5 测试弹体（太空战架构 §4/§5.1）：不可建造、只经弹体服务/武器发射 spawn。
		弹体 def = 联合效果注册表键 + 贴图来源 + 脚印/HP 载体；
		可拦截性结构派生（有图 ⇔ 可拦截），无标记字段。
		贴图暂借原版弹丸图占位（正式贴图随段6 武器 def 族）。
	-->

	<!-- 测试直射弹：无图型（不可拦截）、恒速直线。「低速重弹（有图直射示例）」是
	     §15.8 清单的独立项，将来需要时另建 def；默认直射弹不持有地图（齐射零建图开销）。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_Cannon</defName>
		<label>cannon shot</label>
		<description>Test projectile: a slow heavy shell flying straight in the universe layer.</description>
		<thingClass>Verse.Building</thingClass>
		<category>Building</category>
		<rotatable>false</rotatable>
		<passability>Impassable</passability>
		<fillPercent>0.4</fillPercent>
		<size>(1,1)</size>
		<designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" />
		<stuffCategories Inherit="False" />
		<statBases>
			<WorkToBuild>1</WorkToBuild>
			<MaxHitPoints>40</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Projectile/ShellHighExplosive</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.4,1.4)</drawSize>
			<shaderType>Cutout</shaderType>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_SpaceProjectile">
				<speed>45</speed>
				<timeoutTicks>900</timeoutTicks>
				<hasMap>false</hasMap>
				<shieldBehaviorClass>DeltaV.CannonShieldProjectileBehavior</shieldBehaviorClass>
				<shieldPulseCost>18</shieldPulseCost><shieldBreakAngleDeg>7</shieldBreakAngleDeg>
				<shieldFragmentDef>DeltaV_Projectile_ShieldFragment</shieldFragmentDef>
				<shieldFragmentCount>3</shieldFragmentCount><shieldFragmentScatterDeg>11</shieldFragmentScatterDeg>
				<shieldFragmentSpeedFactor>0.72</shieldFragmentSpeedFactor>
				<shieldFragmentDamageFraction>0.28</shieldFragmentDamageFraction>
				<shieldFragmentArmorFactor>0.28</shieldFragmentArmorFactor>
			</li>
		</comps>
	</ThingDef>

	<!-- 速射炮用独立弹体注册低穿层效果；视觉采用原版机炮弹。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_Rapid</defName>
		<label>rapid cannon shot</label>
		<description>A compact rapid cannon projectile.</description>
		<thingClass>Verse.Building</thingClass><category>Building</category>
		<rotatable>false</rotatable><passability>Impassable</passability><fillPercent>0.2</fillPercent>
		<size>(1,1)</size><designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" /><stuffCategories Inherit="False" />
		<statBases><WorkToBuild>1</WorkToBuild><MaxHitPoints>10</MaxHitPoints><Flammability>0</Flammability></statBases>
		<graphicData><texPath>Things/Projectile/Bullet_Big</texPath><graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.1,1.1)</drawSize><shaderType>Cutout</shaderType>
			<damageData><enabled>false</enabled></damageData></graphicData>
		<comps><li Class="DeltaV.CompProperties_SpaceProjectile">
			<speed>45</speed><timeoutTicks>900</timeoutTicks><hasMap>false</hasMap>
		</li></comps>
	</ThingDef>

	<!-- 测试激光：无图即时链（不可拦截），全射程一次扫掠。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_Laser</defName>
		<label>laser bolt</label>
		<description>Test projectile: an instant laser beam sweeping to its maximum range on the tick it fires.</description>
		<thingClass>Verse.Building</thingClass>
		<category>Building</category>
		<rotatable>false</rotatable>
		<passability>Impassable</passability>
		<fillPercent>0.1</fillPercent>
		<size>(1,1)</size>
		<designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" />
		<stuffCategories Inherit="False" />
		<statBases>
			<WorkToBuild>1</WorkToBuild>
			<MaxHitPoints>10</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.2,1.2)</drawSize>
			<shaderType>Cutout</shaderType>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_SpaceProjectile">
				<hasMap>false</hasMap>
				<laserRange>120</laserRange>
			</li>
		</comps>
	</ThingDef>

	<!-- 重激光：大型激光炮用即时链，射程随炮型（160）。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_LaserHeavy</defName>
		<label>heavy laser bolt</label>
		<description>An instant heavy laser beam sweeping to its maximum range on the tick it fires.</description>
		<thingClass>Verse.Building</thingClass>
		<category>Building</category>
		<rotatable>false</rotatable>
		<passability>Impassable</passability>
		<fillPercent>0.1</fillPercent>
		<size>(1,1)</size>
		<designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" />
		<stuffCategories Inherit="False" />
		<statBases>
			<WorkToBuild>1</WorkToBuild>
			<MaxHitPoints>10</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.6,1.6)</drawSize>
			<shaderType>Cutout</shaderType>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_SpaceProjectile">
				<hasMap>false</hasMap>
				<laserRange>160</laserRange>
			</li>
		</comps>
	</ThingDef>

	<!-- 测试导弹：有图型（可拦截）、纯追踪制导。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_Missile</defName>
		<label>guided missile</label>
		<description>Test projectile: a guided missile that turns toward its target every tick.</description>
		<thingClass>Verse.Building</thingClass>
		<category>Building</category>
		<rotatable>false</rotatable>
		<passability>Impassable</passability>
		<fillPercent>0.4</fillPercent>
		<size>(1,1)</size>
		<designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" />
		<stuffCategories Inherit="False" />
		<statBases>
			<WorkToBuild>1</WorkToBuild>
			<MaxHitPoints>25</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Projectile/DeltaV_MissileHE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.3,1.3)</drawSize>
			<shaderType>Cutout</shaderType>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_SpaceProjectile">
				<speed>32</speed>
				<timeoutTicks>1800</timeoutTicks>
				<guided>true</guided>
				<shieldBehaviorClass>DeltaV.UnshieldedProjectileBehavior</shieldBehaviorClass>
				<turnRateDegPerSec>540</turnRateDegPerSec>
				<coldLaunchTicks>30</coldLaunchTicks>
				<coldLaunchSpeedFactor>0.25</coldLaunchSpeedFactor>
				<lockArcDeg>360</lockArcDeg>
				<hasMap>true</hasMap>
				<exhaustTrail>true</exhaustTrail>
				<exhaustSize>1.4</exhaustSize>
				<smokeLifetimeTicks>150</smokeLifetimeTicks>
			</li>
		</comps>
	</ThingDef>


	<!-- 护盾未能完全吸收即时光束时抛出的低能破片；走普通无图弹体链。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_ShieldFragment</defName>
		<label>shield breach fragment</label>
		<description>A weakened fragment emerging from a collapsed shield.</description>
		<thingClass>Verse.Building</thingClass><category>Building</category>
		<rotatable>false</rotatable><passability>Impassable</passability><fillPercent>0.2</fillPercent>
		<size>(1,1)</size><designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" /><stuffCategories Inherit="False" />
		<statBases><WorkToBuild>1</WorkToBuild><MaxHitPoints>10</MaxHitPoints><Flammability>0</Flammability></statBases>
		<graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.7,0.7)</drawSize><shaderType>Cutout</shaderType>
			<damageData><enabled>false</enabled></damageData></graphicData>
		<comps><li Class="DeltaV.CompProperties_SpaceProjectile">
			<speed>45</speed><timeoutTicks>300</timeoutTicks><hasMap>false</hasMap>
			<shieldPulseCost>2</shieldPulseCost>
		</li></comps>
	</ThingDef>

	<!-- 轨道炮钢针碎片：独立 Def 与自身护盾响应，后续盾层继续按普通弹体折射。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_RailFragment</defName>
		<label>railgun fragment</label>
		<description>A dense splinter produced when a railgun slug crosses a shield at an angle.</description>
		<thingClass>Verse.Building</thingClass><category>Building</category>
		<rotatable>false</rotatable><passability>Impassable</passability><fillPercent>0.2</fillPercent>
		<size>(1,1)</size><designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" /><stuffCategories Inherit="False" />
		<statBases><WorkToBuild>1</WorkToBuild><MaxHitPoints>10</MaxHitPoints><Flammability>0</Flammability></statBases>
		<graphicData><texPath>Things/Projectile/Bullet_Big</texPath><graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.55,0.55)</drawSize><shaderType>Cutout</shaderType>
			<damageData><enabled>false</enabled></damageData></graphicData>
		<comps><li Class="DeltaV.CompProperties_SpaceProjectile">
			<speed>80</speed><timeoutTicks>240</timeoutTicks><hasMap>false</hasMap>
			<shieldPulseCost>3</shieldPulseCost>
		</li></comps>
	</ThingDef>

	<!-- 点防激光：复用即时扫掠和光束材质，以独立 Def 控制伤害和线宽。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Projectile_PDLaser</defName>
		<label>point-defense laser</label>
		<description>An instant narrow laser beam used by the point-defense turret.</description>
		<thingClass>Verse.Building</thingClass>
		<category>Building</category>
		<rotatable>false</rotatable>
		<passability>Impassable</passability>
		<fillPercent>0.1</fillPercent>
		<size>(1,1)</size>
		<designationCategory Inherit="False" />
		<researchPrerequisites Inherit="False" />
		<stuffCategories Inherit="False" />
		<statBases>
			<WorkToBuild>1</WorkToBuild>
			<MaxHitPoints>10</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.2,1.2)</drawSize>
			<shaderType>Cutout</shaderType>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<comps>
			<li Class="DeltaV.CompProperties_SpaceProjectile">
				<hasMap>false</hasMap>
				<laserRange>50</laserRange>
				<laserBeamWidth>0.12</laserBeamWidth>
				<guaranteedHitMissiles>true</guaranteedHitMissiles>
			</li>
		</comps>
	</ThingDef>

</Defs>
