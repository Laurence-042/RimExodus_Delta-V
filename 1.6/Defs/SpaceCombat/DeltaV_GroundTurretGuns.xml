<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- The ground verbs remain ordinary RimWorld turret verbs. Space fire uses CompSpaceWeapon. -->
  <ThingDef ParentName="BaseBullet">
    <defName>DeltaV_GroundHeavyShell</defName><label>ship cannon shell</label>
    <graphicData><texPath>Things/Projectile/Bullet_Big</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>1.3</drawSize></graphicData>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>45</damageAmountBase><speed>50</speed></projectile>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DeltaV_GroundRapidShell</defName><label>ship autocannon shell</label>
    <graphicData><texPath>Things/Projectile/Bullet_Big</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <projectile><damageDef>Bullet</damageDef><damageAmountBase>24</damageAmountBase><speed>65</speed></projectile>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>DeltaV_GroundLaserBeam</defName><label>ship laser beam</label><thingClass>Beam</thingClass>
    <graphicData><texPath>Things/Projectile/Bullet_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <projectile><damageDef>Beam</damageDef><damageAmountBase>20</damageAmountBase><beamMoteDef>Mote_BeamRepeaterLaser</beamMoteDef><beamStartOffset>0.5</beamStartOffset><armorPenetrationBase>0.25</armorPenetrationBase></projectile>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret" Name="DeltaV_GroundGunBase" Abstract="True">
    <graphicData><texPath>Things/Building/Security/TurretAutocannon_Top</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><AccuracyTouch>0.25</AccuracyTouch><AccuracyShort>0.66</AccuracyShort><AccuracyMedium>0.62</AccuracyMedium><AccuracyLong>0.48</AccuracyLong><RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown><DeteriorationRate>0</DeteriorationRate><Mass>40</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>

  <ThingDef ParentName="DeltaV_GroundGunBase">
    <defName>DeltaV_GroundGun_HeavySmall</defName><label>small ship heavy cannon</label>
    <verbs><li><verbClass>DeltaV.Verb_SpaceTurretGround</verbClass><defaultProjectile>DeltaV_GroundHeavyShell</defaultProjectile><warmupTime>0</warmupTime><minRange>13</minRange><range>33</range><burstShotCount>1</burstShotCount><soundCast>Shot_TurretSniper</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>15</muzzleFlashScale><consumeFuelPerShot>8</consumeFuelPerShot></li></verbs>
  </ThingDef>
  <ThingDef ParentName="DeltaV_GroundGunBase">
    <defName>DeltaV_GroundGun_HeavyMedium</defName><label>medium ship heavy cannon</label>
    <verbs><li><verbClass>DeltaV.Verb_SpaceTurretGround</verbClass><defaultProjectile>DeltaV_GroundHeavyShell</defaultProjectile><warmupTime>0</warmupTime><minRange>17</minRange><range>37</range><burstShotCount>2</burstShotCount><ticksBetweenBurstShots>24</ticksBetweenBurstShots><soundCast>Shot_TurretSniper</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>18</muzzleFlashScale><consumeFuelPerShot>12</consumeFuelPerShot></li></verbs>
  </ThingDef>
  <ThingDef ParentName="DeltaV_GroundGunBase">
    <defName>DeltaV_GroundGun_RapidSmall</defName><label>small ship rapid cannon</label>
    <verbs><li><verbClass>DeltaV.Verb_SpaceTurretGround</verbClass><defaultProjectile>DeltaV_GroundRapidShell</defaultProjectile><warmupTime>0</warmupTime><minRange>13</minRange><range>33</range><burstShotCount>3</burstShotCount><ticksBetweenBurstShots>18</ticksBetweenBurstShots><soundCast>Shot_Autocannon</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>12</muzzleFlashScale><consumeFuelPerShot>2</consumeFuelPerShot></li></verbs>
  </ThingDef>
  <ThingDef ParentName="DeltaV_GroundGunBase">
    <defName>DeltaV_GroundGun_RapidMedium</defName><label>medium ship rapid cannon</label>
    <verbs><li><verbClass>DeltaV.Verb_SpaceTurretGround</verbClass><defaultProjectile>DeltaV_GroundRapidShell</defaultProjectile><warmupTime>0</warmupTime><minRange>17</minRange><range>37</range><burstShotCount>4</burstShotCount><ticksBetweenBurstShots>15</ticksBetweenBurstShots><soundCast>Shot_Autocannon</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>14</muzzleFlashScale><consumeFuelPerShot>3</consumeFuelPerShot></li></verbs>
  </ThingDef>
  <ThingDef ParentName="DeltaV_GroundGunBase">
    <defName>DeltaV_GroundGun_LaserSmall</defName><label>small ship laser cannon</label>
    <verbs><li><verbClass>DeltaV.Verb_SpaceTurretGround</verbClass><defaultProjectile>DeltaV_GroundLaserBeam</defaultProjectile><warmupTime>0</warmupTime><minRange>13</minRange><range>33</range><burstShotCount>2</burstShotCount><ticksBetweenBurstShots>20</ticksBetweenBurstShots><soundCast>Shot_BeamRepeater</soundCast><soundCastTail>GunTail_Medium</soundCastTail><muzzleFlashScale>9</muzzleFlashScale></li></verbs>
  </ThingDef>
  <ThingDef ParentName="DeltaV_GroundGunBase">
    <defName>DeltaV_GroundGun_LaserMedium</defName><label>medium ship laser cannon</label>
    <verbs><li><verbClass>DeltaV.Verb_SpaceTurretGround</verbClass><defaultProjectile>DeltaV_GroundLaserBeam</defaultProjectile><warmupTime>0</warmupTime><minRange>17</minRange><range>37</range><burstShotCount>3</burstShotCount><ticksBetweenBurstShots>18</ticksBetweenBurstShots><soundCast>Shot_BeamRepeater</soundCast><soundCastTail>GunTail_Medium</soundCastTail><muzzleFlashScale>11</muzzleFlashScale></li></verbs>
  </ThingDef>
</Defs>
