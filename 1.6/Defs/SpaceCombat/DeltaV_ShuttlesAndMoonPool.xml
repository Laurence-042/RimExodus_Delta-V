<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		月池（太空战架构 §7；2026-09-27 修订：真继承）。**ParentName="Substructure"
		直接继承原版逆重基架**（原版 def 经 Patches/DeltaV_Shuttle.xml 补 Name 特性）：
		只写差异字段，tags/affordances/placeWorkers/造价/工时/引擎门禁/建造分类等全部
		继承——游戏更新改基架属性月池自动跟随。专用 RoofDef 提供密封与室内语义；
		仅照明和穿梭机校验有局部豁免。力场视觉 = MoonPoolGraphics 墙壁式
		连接图（地形本体 dontRender 透出宇宙）。
	-->
	<TerrainDef ParentName="Substructure">
		<defName>DeltaV_MoonPool</defName>
    <researchPrerequisites Inherit="False"><li>DeltaV_VacuumBarrier</li></researchPrerequisites>
    <costList Inherit="False"><Steel>6</Steel><GravlitePanel>2</GravlitePanel></costList>
    <statBases><WorkToBuild>900</WorkToBuild></statBases>
		<label>moon pool</label>
		<description>A gravship substructure deck section sealed by a transparent force-field roof. It holds air and protects the room while admitting daylight. Shuttles can launch and land through it; any ordinary roof built here remains until removed.</description>
		<texturePath>Terrain/MoonPool</texturePath>
		<uiIconPath>Terrain/MoonPool</uiIconPath>
		<dontRender>true</dontRender>
		<holdSnowOrSand>false</holdSnowOrSand>
		<designationHotKey Inherit="False" />
		<uiOrder>1001</uiOrder>
	</TerrainDef>

	<RoofDef>
		<defName>DeltaV_MoonPoolFieldRoof</defName>
		<label>moon pool force field</label>
		<canCollapse>false</canCollapse>
	</RoofDef>

	<!--
		跳帮 shuttle（2026-09-27 修订：真继承）。**ParentName="PassengerShuttle"
		直接继承原版载人穿梭机**（原版 def 经 patch 补 Name 特性 + CompSpaceShuttle）：
		size/全套原版 comps（CompShuttle/CompLaunchable/CompTransporter/
		CompRefuelable）/inspectorTabs/placeWorkers 全部继承，子 def 另写数值与美术差异。
		graphicData 换成 Delta-V 专属单张俯视图，四向由 Graphic_Single 旋转。
		**跳帮档位（canBoard/出力）放 modExtensions**——comps li 追加会与原版 patch
		的 comp 实例重复（TryGetComp 取首个导致 canBoard=false 生效），modExtensions
		是允许追加的字段族且原版无此项，无重复；CompSpaceShuttle.CanBoard/
		EffectiveThrust 单一解析点读它。
	-->
	<ThingDef ParentName="PassengerShuttle">
		<defName>DeltaV_ShuttleBoarding</defName>
		<label>boarding shuttle</label>
		<description>An armored assault shuttle. In flight, disable collision avoidance and use Ram target hull to pick an enemy ship. The main engines burn chemfuel from a separate afterburner tank during the intercept. The shuttle passes through shields, remains vulnerable to point defense, and seals the breach for its crew to disembark.</description>
		<uiIconPath>Things/Building/Shuttle/BoardingShuttle_MenuIcon</uiIconPath>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Things/Building/Shuttle/BoardingShuttle</texPath>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3,5)</drawSize>
		</graphicData>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<interactionCellOffset>(0,0,3)</interactionCellOffset>
		<comps>
			<li Class="DeltaV.CompProperties_AfterburnerTank">
				<fuelCapacity>60</fuelCapacity>
				<fuelConsumptionRate>1875</fuelConsumptionRate>
				<autoRefuelPercent>1</autoRefuelPercent>
				<showFuelGizmo>true</showFuelGizmo>
				<fuelFilter><thingDefs><li>Chemfuel</li></thingDefs></fuelFilter>
			</li>
			<li Class="DeltaV.CompProperties_SpaceProjectile">
				<timeoutTicks>7200</timeoutTicks>
				<ignoresShields>true</ignoresShields>
				<hasMap>true</hasMap>
			</li>
		</comps>
		<statBases>
			<MaxHitPoints>850</MaxHitPoints>
			<Flammability>0.3</Flammability>
			<WorkToBuild>60000</WorkToBuild>
			<Mass>280</Mass>
		</statBases>
		<costList Inherit="False"><Steel>300</Steel><Plasteel>250</Plasteel><ComponentIndustrial>8</ComponentIndustrial><ComponentSpacer>2</ComponentSpacer><ShuttleEngine>1</ShuttleEngine></costList>
		<researchPrerequisites Inherit="False"><li>Shuttles</li><li>OrbitalTech</li></researchPrerequisites>
		<modExtensions>
			<li Class="DeltaV.DefModExtension_BoardingProfile">
				<canBoard>true</canBoard>
				<!--
					船体帧 +X=舱头、+Y=左侧；按 3x5 正式贴图定位全部喷口。
					头部排气斜向前，中部排气斜向后，推力与排气反向。
					四台斜推兼任纵向、侧向与姿控；力矩按真实位置计算。
				-->
				<boostMultiplier>1.5</boostMultiplier>
				<virtualThrusters>
					<li><position>(-2.2,0.69)</position><force>(2700,0)</force></li>
					<li><position>(-2.2,-0.69)</position><force>(2700,0)</force></li>
					<li><position>(2.02,0.85)</position><force>(-1900,-1900)</force></li>
					<li><position>(2.02,-0.85)</position><force>(-1900,1900)</force></li>
					<li><position>(-0.55,1.1)</position><force>(1500,-6900)</force></li>
					<li><position>(-0.55,-1.1)</position><force>(1500,6900)</force></li>
				</virtualThrusters>
			</li>
		</modExtensions>
		<uiOrder>2601</uiOrder>
	</ThingDef>

</Defs>
