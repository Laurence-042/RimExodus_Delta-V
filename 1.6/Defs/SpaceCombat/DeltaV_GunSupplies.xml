<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>DeltaV_Propellant</defName>
    <label>ship propellant</label>
    <description>Ammunition components for ship guns. Load propellant and projectile heads separately.</description>
    <graphicData>
      <texPath>Things/Item/Resource/DeltaV_Propellant</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>500</stackLimit>
    <statBases>
      <Mass>0.025</Mass>
      <MarketValue>0.1</MarketValue>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
  <RecipeDef>
    <defName>DeltaV_MakePropellant</defName>
    <label>make ship propellant x200</label>
    <description>Steel is flammable. Everyone knows that.</description>
    <jobString>Making ship propellant.</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <DeltaV_Propellant>200</DeltaV_Propellant>
    </products>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <researchPrerequisite>DeltaV_ShipArtillery</researchPrerequisite>
  </RecipeDef>
  <ThingDef ParentName="ResourceBase">
    <defName>DeltaV_SteelHead</defName>
    <label>high-explosive projectile heads</label>
    <description>High-explosive projectile heads made from steel for rapid and heavy ship guns. In space they detonate on impact; more heads increase blast damage and radius. At equal charge, a heavier shot travels more slowly and better resists kinetic-shield deflection.</description>
    <graphicData>
      <texPath>Things/Item/Resource/DeltaV_SteelHead</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>500</stackLimit>
    <statBases>
      <Mass>0.025</Mass>
      <MarketValue>0.1</MarketValue>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
  <RecipeDef>
    <defName>DeltaV_MakeSteelHead</defName>
    <label>make high-explosive projectile heads x200</label>
    <description>Steel is flammable. Everyone knows that.</description>
    <jobString>Making high-explosive projectile heads.</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <DeltaV_SteelHead>200</DeltaV_SteelHead>
    </products>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <researchPrerequisite>DeltaV_ShipArtillery</researchPrerequisite>
  </RecipeDef>
  <ThingDef ParentName="ResourceBase">
    <defName>DeltaV_UraniumHead</defName>
    <label>armor-piercing projectile heads</label>
    <description>Armor-piercing projectile heads made from uranium for auxiliary magazines and the railgun loader. Their impact energy determines how far they penetrate structures. In a chemical gun, their greater mass lowers muzzle speed at equal charge and helps resist kinetic-shield deflection.</description>
    <graphicData>
      <texPath>Things/Item/Resource/DeltaV_UraniumHead</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>500</stackLimit>
    <statBases>
      <Mass>0.025</Mass>
      <MarketValue>0.5</MarketValue>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
  <RecipeDef>
    <defName>DeltaV_MakeUraniumHead</defName>
    <label>make armor-piercing projectile heads x200</label>
    <description>Produce 200 projectile head units from 10 units of material.</description>
    <jobString>Making armor-piercing projectile heads.</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Uranium</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Uranium</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <DeltaV_UraniumHead>200</DeltaV_UraniumHead>
    </products>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <researchPrerequisite>DeltaV_ShipArtillery</researchPrerequisite>
  </RecipeDef>
  <JobDef>
    <defName>DeltaV_LoadGunSupply</defName>
    <driverClass>DeltaV.JobDriver_LoadGunSupply</driverClass>
    <reportString>loading TargetA.</reportString>
    <suspendable>false</suspendable>
  </JobDef>
</Defs>
