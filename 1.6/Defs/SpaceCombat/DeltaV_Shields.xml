<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Independent Delta-V shield: the Odyssey generator remains unchanged. -->
  <ThingDef ParentName="GravshipComponentBase">
    <defName>DeltaV_ShieldGenerator</defName>
    <label>Delta-V shield generator</label>
    <description>A three-mode shield. Guard shares 1000 regular capacity with this ship and keeps 2000 emergency capacity for local hits. After 10 seconds without regular consumption, powered recovery fills the regular capacity over one game hour at an additional 1000 W. Emergency capacity requires silver. Kinetic fragments solid shots; electromagnetic refracts lasers. Line modes require power and do not share capacity.</description>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/SpaceWeapons/ShieldGenerator_MenuIcon</uiIconPath>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <uiOrder>-181</uiOrder>
    <rotatable>true</rotatable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <size>(3,3)</size>
    <fillPercent>0.6</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <statBases><MaxHitPoints>250</MaxHitPoints><Flammability>0.3</Flammability><Mass>80</Mass></statBases>
    <costList><Steel>200</Steel><GravlitePanel>80</GravlitePanel><ComponentSpacer>8</ComponentSpacer></costList>
    <building><turretTopDrawSize>2.8</turretTopDrawSize><blueprintGraphicData><texPath>Things/Building/SpaceWeapons/ShieldGenerator_MenuIcon</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>EdgeDetect</shaderType><drawSize>(3,3)</drawSize></blueprintGraphicData></building>
    <modExtensions>
      <li Class="DeltaV.DefModExtension_SpaceTurretArt">
        <topTexPath>Things/Building/SpaceWeapons/ShieldProjector</topTexPath>
      </li>
    </modExtensions>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/SpaceWeapons/ShieldGenerator</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <comps Inherit="False">
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass><basePowerConsumption>10</basePowerConsumption>
      </li>
      <li Class="CompProperties_Refuelable">
        <compClass>DeltaV.CompDeltaVShieldSilverFuel</compClass>
        <fuelCapacity>2000</fuelCapacity><initialFuelPercent>0</initialFuelPercent>
        <fuelFilter><thingDefs><li>Silver</li></thingDefs></fuelFilter>
        <fuelLabel>shield repair silver</fuelLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>false</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
      </li>
      <li Class="CompProperties_ProjectileInterceptor">
        <compClass>DeltaV.CompDeltaVShieldInterceptor</compClass>
        <radius>24.9</radius>
        <interceptGroundProjectiles>true</interceptGroundProjectiles>
        <interceptAirProjectiles>true</interceptAirProjectiles>
        <color>(0.4, 0.4, 0.4)</color>
        <reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
        <activeSound>BulletShield_Ambience</activeSound>
        <hitPoints>0</hitPoints>
        <hitPointsRestoreInstantlyAfterCharge>false</hitPointsRestoreInstantlyAfterCharge>
        <startWithMaxHitPoints>true</startWithMaxHitPoints>
        <chargeDurationTicks>0</chargeDurationTicks>
        <minIdleAlpha>0.2</minIdleAlpha><drawWithNoSelection>true</drawWithNoSelection>
        <disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
        <gizmoTipKey>GravshipShieldTip</gizmoTipKey>
        <alwaysShowHitpointsGizmo>true</alwaysShowHitpointsGizmo>
        <rechargeHitPointsIntervalTicks>75</rechargeHitPointsIntervalTicks>
        <activated>false</activated>
      </li>
      <li Class="DeltaV.CompProperties_SpaceShield" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="GravshipComponentBase">
    <defName>DeltaV_ShieldGeneratorSmall</defName>
    <label>small Delta-V shield generator</label>
    <description>A compact three-mode shield. Its guard dome has 1000 local emergency capacity, restored only with silver; it cannot use shared regular capacity. Powered kinetic and electromagnetic line modes project up to 16 cells and span up to 16 cells.</description>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/SpaceWeapons/ShieldGeneratorSmall_MenuIcon</uiIconPath>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <uiOrder>-180</uiOrder>
    <rotatable>true</rotatable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <size>(1,1)</size>
    <fillPercent>0.6</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <statBases><WorkToBuild>1800</WorkToBuild><MaxHitPoints>120</MaxHitPoints><Flammability>0.3</Flammability><Mass>20</Mass></statBases>
    <costList><Steel>100</Steel><GravlitePanel>30</GravlitePanel><ComponentSpacer>4</ComponentSpacer></costList>
    <building><turretTopDrawSize>1.2</turretTopDrawSize><blueprintGraphicData><texPath>Things/Building/SpaceWeapons/ShieldGeneratorSmall_MenuIcon</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>EdgeDetect</shaderType><drawSize>(1.3,1.3)</drawSize></blueprintGraphicData></building>
    <modExtensions>
      <li Class="DeltaV.DefModExtension_SpaceTurretArt">
        <topTexPath>Things/Building/SpaceWeapons/ShieldProjector</topTexPath>
      </li>
    </modExtensions>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/SpaceWeapons/PointDefense_Base</texPath>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <comps Inherit="False">
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass><basePowerConsumption>10</basePowerConsumption>
      </li>
      <li Class="CompProperties_Refuelable">
        <compClass>DeltaV.CompDeltaVShieldSilverFuel</compClass>
        <fuelCapacity>1000</fuelCapacity><initialFuelPercent>0</initialFuelPercent>
        <fuelFilter><thingDefs><li>Silver</li></thingDefs></fuelFilter>
        <fuelLabel>shield repair silver</fuelLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>false</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
      </li>
      <li Class="CompProperties_ProjectileInterceptor">
        <compClass>DeltaV.CompDeltaVShieldInterceptor</compClass>
        <radius>24.9</radius>
        <interceptGroundProjectiles>true</interceptGroundProjectiles>
        <interceptAirProjectiles>true</interceptAirProjectiles>
        <color>(0.4, 0.4, 0.4)</color>
        <reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
        <activeSound>BulletShield_Ambience</activeSound>
        <hitPoints>0</hitPoints>
        <hitPointsRestoreInstantlyAfterCharge>false</hitPointsRestoreInstantlyAfterCharge>
        <startWithMaxHitPoints>true</startWithMaxHitPoints>
        <chargeDurationTicks>0</chargeDurationTicks>
        <minIdleAlpha>0.2</minIdleAlpha><drawWithNoSelection>true</drawWithNoSelection>
        <disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
        <gizmoTipKey>GravshipShieldTip</gizmoTipKey>
        <alwaysShowHitpointsGizmo>true</alwaysShowHitpointsGizmo>
        <rechargeHitPointsIntervalTicks>75</rechargeHitPointsIntervalTicks>
        <activated>false</activated>
      </li>
      <li Class="DeltaV.CompProperties_SpaceShield"><regularCapacity>0</regularCapacity><emergencyCapacity>1000</emergencyCapacity><maxProjection>16</maxProjection><maxLength>16</maxLength></li>
    </comps>
  </ThingDef>
</Defs>
