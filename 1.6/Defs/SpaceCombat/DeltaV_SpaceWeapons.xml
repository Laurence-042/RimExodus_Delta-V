  <!-- Airtight wall launchers. -->
  <ThingDef ParentName="DeltaV_SpaceWallWeapon">
    <defName>DeltaV_Weapon_MissileLauncher</defName><label>missile launcher</label><description>An airtight cold-launch missile rack with autonomous guidance.</description>
    <size>(1,3)</size><drawerType>MapMeshAndRealTime</drawerType><costList><Steel>420</Steel><ComponentIndustrial>12</ComponentIndustrial></costList>
    <uiIconPath>Things/Building/SpaceWeapons/MissileLauncher_MenuIcon</uiIconPath>
    <graphicData><texPath>Things/Building/SpaceWeapons/MissileLauncher_Inner</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>Cutout</shaderType><drawSize>(1.06,3)</drawSize><drawOffsetNorth>(0,0,0.15)</drawOffsetNorth><drawOffsetEast>(0.15,0,0)</drawOffsetEast><drawOffsetSouth>(0,0,-0.15)</drawOffsetSouth><drawOffsetWest>(-0.15,0,0)</drawOffsetWest><linkFlags><li>Wall</li></linkFlags></graphicData>
    <placeWorkers><li>DeltaV.PlaceWorker_MissileLauncher</li></placeWorkers>
    <inspectorTabs><li>ITab_Storage</li></inspectorTabs>
    <building><fixedStorageSettings><filter><thingDefs><li>DeltaV_Missile_HE</li></thingDefs></filter></fixedStorageSettings><defaultStorageSettings><filter><thingDefs><li>DeltaV_Missile_HE</li></thingDefs></filter></defaultStorageSettings><relatedBuildCommands><li>DeltaV_Building_MissileMagazine</li></relatedBuildCommands></building>
    <statBases><WorkToBuild>7000</WorkToBuild><MaxHitPoints>620</MaxHitPoints></statBases>
    <comps>
      <li Class="CompProperties_ChangeableProjectile" />
      <li Class="DeltaV.CompProperties_SpaceWeaponMagazine" />
      <li Class="DeltaV.CompProperties_SpaceWeapon"><projectileDef>DeltaV_Projectile_Missile</projectileDef><topTurret>false</topTurret><fireArcDeg>0</fireArcDeg><lockArcDeg>360</lockArcDeg><defaultFireDeviationDeg>180</defaultFireDeviationDeg><ignitionDelayTicks>30</ignitionDelayTicks><baseSpreadDeg>0.4</baseSpreadDeg><cooldownTicks>300</cooldownTicks><range>220</range><muzzleOffset>(0,1.6)</muzzleOffset><intrinsicAimSkill>20</intrinsicAimSkill></li>
      <li Class="DeltaV.CompProperties_MissileAutoloader"><magazineDefs><li>DeltaV_Building_MissileMagazine</li></magazineDefs><magazineRootOffsets><li>(-1,0,-1)</li><li>(1,0,-1)</li></magazineRootOffsets></li>
      <li Class="DeltaV.CompProperties_LoadedProjectileGraphic"><drawSize>(1.3,1.3)</drawSize><drawOffset>(-0.05,0.35)</drawOffset></li>
      <li Class="CompProperties_DrawAdditionalGraphics"><graphics><li><texPath>Things/Building/SpaceWeapons/MissileLauncher_Outer</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>Cutout</shaderType><drawSize>(1.06,3)</drawSize><drawOffsetNorth>(0,0.033,0.15)</drawOffsetNorth><drawOffsetEast>(0.15,0.033,0)</drawOffsetEast><drawOffsetSouth>(0,0.033,-0.15)</drawOffsetSouth><drawOffsetWest>(-0.15,0.033,0)</drawOffsetWest></li></graphics></li>
    </comps>
  </ThingDef>

