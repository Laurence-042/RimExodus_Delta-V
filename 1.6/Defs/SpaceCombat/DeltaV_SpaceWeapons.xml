      <li Class="DeltaV.CompProperties_SpaceWeaponTraverse"><turnRateDegPerSec>540</turnRateDegPerSec><fireToleranceDeg>0.25</fireToleranceDeg></li>
      <li Class="DeltaV.CompProperties_SpaceWeapon"><projectileDef>DeltaV_Projectile_PDLaser</projectileDef><aimMode>PointDefense</aimMode><pointDefenseOnly>true</pointDefenseOnly><defaultSalvoSet>Secondary</defaultSalvoSet><topTurret>true</topTurret><turretMuzzleDistance>0.52</turretMuzzleDistance><fireArcDeg>360</fireArcDeg><defaultFireDeviationDeg>0.25</defaultFireDeviationDeg><intrinsicAimSkill>16</intrinsicAimSkill><baseSpreadDeg>0.15</baseSpreadDeg><cooldownTicks>110</cooldownTicks><range>50</range><shotEnergy>1</shotEnergy></li>
    </comps>
    <modExtensions><li Class="DeltaV.DefModExtension_SpaceTurretArt"><topTexPath>Things/Building/SpaceWeapons/LaserTurret_Top</topTexPath></li></modExtensions>
  </ThingDef>

