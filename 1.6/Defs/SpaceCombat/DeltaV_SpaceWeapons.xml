	<!-- ⑥a 轨道炮·装弹机构：弹药装载/存储（原版 CompRefuelable 装填语义）。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Weapon_RailgunLoader</defName>
		<label>railgun loader</label>
		<description>The ammunition end of a modular railgun: stores and feeds railgun slugs. One link chain per muzzle; the loader must stay powered for the chain to fire.</description>
		<thingClass>Building</thingClass>
		<rotatable>false</rotatable>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<tickerType>Normal</tickerType>
		<fillPercent>0.5</fillPercent>
		<size>(1,1)</size>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<designationCategory>Security</designationCategory>
		<placeWorkers>
			<li>DeltaV.PlaceWorker_RailgunPart</li>
		</placeWorkers>
		<costList>
			<Steel>60</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToBuild>1000</WorkToBuild>
			<MaxHitPoints>120</MaxHitPoints>
			<Flammability>0.3</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Building/GravshipShieldGenerator</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.4,1.4)</drawSize>
			<damageData><enabled>false</enabled></damageData>
		</graphicData>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>40</basePowerConsumption>
			</li>
			<li Class="CompProperties_Refuelable">
				<fuelLabel>Railgun slugs</fuelLabel>
				<fuelGizmoLabel>Slugs</fuelGizmoLabel>
				<outOfFuelMessage>Needs railgun slugs</outOfFuelMessage>
				<fuelFilter>
					<thingDefs>
						<li>DeltaV_Item_RailgunShell</li>
					</thingDefs>
				</fuelFilter>
				<fuelCapacity>10</fuelCapacity>
				<initialFuelPercent>1.0</initialFuelPercent>
				<autoRefuelPercent>0.5</autoRefuelPercent>
				<showFuelGizmo>true</showFuelGizmo>
				<minimumFueledThreshold>1</minimumFueledThreshold>
			</li>
			<li Class="DeltaV.CompProperties_SpaceRailgun">
				<role>Loader</role>
			</li>
		</comps>
		<researchPrerequisites><li>DeltaV_VacuumBarrier</li></researchPrerequisites>
	</ThingDef>

	<!-- ⑥b 轨道炮·加速段：每节提升穿深/伤害（Σ 汇总，发射时读取）。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Weapon_RailgunAccelerator</defName>
		<label>railgun accelerator segment</label>
		<description>An accelerator segment of a modular railgun. Each segment in the chain (loader → segments → muzzle) adds damage and armor penetration to the muzzle's shot. Straight chains only.</description>
		<thingClass>Building</thingClass>
		<rotatable>false</rotatable>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<tickerType>Normal</tickerType>
		<fillPercent>0.5</fillPercent>
		<size>(1,1)</size>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<designationCategory>Security</designationCategory>
		<placeWorkers>
			<li>DeltaV.PlaceWorker_RailgunPart</li>
		</placeWorkers>
		<costList>
			<Steel>80</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToBuild>1200</WorkToBuild>
			<MaxHitPoints>120</MaxHitPoints>
			<Flammability>0.3</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Building/GravFieldExtender</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.4,1.4)</drawSize>
			<damageData><enabled>false</enabled></damageData>
		</graphicData>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li Class="DeltaV.CompProperties_SpaceRailgun">
				<role>Accelerator</role>
				<damageBonusPerSegment>0.25</damageBonusPerSegment>
				<armorPenBonusPerSegment>0.2</armorPenBonusPerSegment>
			</li>
		</comps>
		<researchPrerequisites><li>DeltaV_VacuumBarrier</li></researchPrerequisites>
	</ThingDef>

