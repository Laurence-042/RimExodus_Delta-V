<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		阶段5 段6 武器 def 族（太空战架构 §5；§15.8 建议清单，贴图占位借原版）。
		双模：thingClass = Building_TurretGun + 原版炮塔 comps（地表/同图战斗走原版
		机制）+ DeltaV.CompSpaceWeapon（太空跨容器射击）。全部要求基架
		（terrainAffordanceNeeded Substructure——归属随基架、随控制域捕获搬运）；
		CompMannable 不设 planetLayerWhitelist（太空层可就位）。
	-->

	<!-- ① 炮塔式直射炮：全向、顶部炮塔（弹排除己方容器）。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DeltaV_Weapon_CannonTurret</defName>
		<label>space cannon turret</label>
		<description>A manned turret firing heavy cannon shots across the universe layer. Top-mounted: its shots never hit the firing ship's own container.</description>
		<thingClass>Building_TurretGun</thingClass>
		<rotatable>true</rotatable>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<tickerType>Normal</tickerType>
		<fillPercent>0.4</fillPercent>
		<size>(1,1)</size>
		<terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
		<designationCategory>Security</designationCategory>
		<costList>
			<Steel>110</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToBuild>1600</WorkToBuild>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>0.4</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Building/Security/TurretMini_Base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
			<damageData><enabled>false</enabled></damageData>
		</graphicData>
		<building>
			<turretGunDef>Gun_MiniTurret</turretGunDef>
			<turretBurstCooldownTime>2.0</turretBurstCooldownTime>
		</building>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li Class="CompProperties_Mannable"><manWorkType>Violent</manWorkType></li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>60</basePowerConsumption>
			</li>
			<li Class="DeltaV.CompProperties_SpaceWeapon">
				<projectileDef>DeltaV_Projectile_Cannon</projectileDef>
				<aimMode>Volley</aimMode>
				<topTurret>true</topTurret>
				<fireArcDeg>360</fireArcDeg>
				<baseSpreadDeg>2.5</baseSpreadDeg>
				<cooldownTicks>120</cooldownTicks>
				<range>140</range>
			</li>
		</comps>
		<researchPrerequisites><li>DeltaV_VacuumBarrier</li></researchPrerequisites>
	</ThingDef>

