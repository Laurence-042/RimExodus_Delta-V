  <!-- 1x1 automated laser point defense. -->
  <ThingDef ParentName="DeltaV_SpaceTurret1">
    <defName>DeltaV_Weapon_PDTurret</defName><label>point-defense laser turret</label>
    <description>An autonomous laser turret dedicated to intercepting incoming missiles and other interceptable craft. It needs no crew or ammunition, but each shot draws stored energy.</description>
    <graphicData><texPath>Things/Building/SpaceWeapons/PointDefense_Base</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.3,1.3)</drawSize><damageData><enabled>false</enabled></damageData></graphicData>
    <building><turretTopDrawSize>1.2</turretTopDrawSize></building>
    <costList><Steel>100</Steel><ComponentIndustrial>4</ComponentIndustrial></costList>
    <statBases><WorkToBuild>1800</WorkToBuild><MaxHitPoints>120</MaxHitPoints><Flammability>0.3</Flammability></statBases>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>45</basePowerConsumption></li>
      <li Class="DeltaV.CompProperties_SpaceWeaponTraverse"><turnRateDegPerSec>540</turnRateDegPerSec><fireToleranceDeg>0.25</fireToleranceDeg></li>
      <li Class="DeltaV.CompProperties_SpaceWeapon"><projectileDef>DeltaV_Projectile_PDLaser</projectileDef><aimMode>PointDefense</aimMode><pointDefenseOnly>true</pointDefenseOnly><defaultSalvoSet>Secondary</defaultSalvoSet><topTurret>true</topTurret><turretMuzzleDistance>0.52</turretMuzzleDistance><fireArcDeg>360</fireArcDeg><defaultFireDeviationDeg>0.25</defaultFireDeviationDeg><intrinsicAimSkill>16</intrinsicAimSkill><baseSpreadDeg>0.15</baseSpreadDeg><cooldownTicks>110</cooldownTicks><range>50</range><shotEnergy>1</shotEnergy></li>
    </comps>
    <modExtensions><li Class="DeltaV.DefModExtension_SpaceTurretArt"><topTexPath>Things/Building/SpaceWeapons/LaserTurret_Top</topTexPath></li></modExtensions>
  </ThingDef>

