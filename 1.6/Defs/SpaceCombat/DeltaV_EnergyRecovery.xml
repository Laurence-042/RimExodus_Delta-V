<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>DeltaV_RailgunEnergyRecovery</defName>
    <researchPrerequisites Inherit="False"><li>DeltaV_Railguns</li><li>Fabrication</li></researchPrerequisites>
    <label>railgun energy recovery module</label>
    <description>Occupies a capacitor slot on a railgun accelerator. Reduces this segment's pulse cost by 25%; two modules reduce it by 50%. Does not reduce the loading unit's base pulse. Has no stored energy or idle power cost.</description>
    <thingClass>Building</thingClass><passability>Standable</passability><size>(1,1)</size>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><designationCategory>Security</designationCategory><uiOrder>-189</uiOrder>
    <altitudeLayer>BuildingOnTop</altitudeLayer><building><isEdifice>false</isEdifice></building>
    <graphicData><texPath>Things/Building/SpaceWeapons/RailgunEnergyRecovery</texPath><graphicClass>DeltaV.Graphic_SpaceWeaponAttachment</graphicClass><drawSize>(1,1)</drawSize><drawOffset>(0,-0.712,0)</drawOffset></graphicData>
    <placeWorkers><li>DeltaV.PlaceWorker_SpaceWeaponAttachment</li></placeWorkers>
    <costList><Steel>80</Steel><Plasteel>30</Plasteel><ComponentIndustrial>4</ComponentIndustrial><ComponentSpacer>1</ComponentSpacer></costList>
    <statBases><WorkToBuild>4000</WorkToBuild><MaxHitPoints>100</MaxHitPoints></statBases>
    <comps><li Class="CompProperties_Forbiddable" /><li Class="DeltaV.CompProperties_RailgunEnergyRecovery">
      <reduction>0.25</reduction>
      <allowedHostDefs>
        <li>DeltaV_Weapon_RailgunAccelerator</li>
      </allowedHostDefs>
    </li></comps>
  </ThingDef>
</Defs>
