<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 星区 POI 命名器（SectorContentService 在 marker 生成时调用）：
       只产名字主干，类型名经 [poi_type] 注入（代码以 extraRules 传入翻译后的类型
       Label），词干与类型名之间的衔接（空格/连接词）由规则自身决定，各语言翻译可
       自行定制。完整名 = 规则输出 + 代码追加 "(派系名) #ID"。
       结构参考原版 NamerGravship / NamerWorldObject_AsteroidBasic，但刻意不带
       「ship/号」类名词后缀——类型名本身就是名词，避免出现「护卫舰号」。 -->
  <RulePackDef>
    <defName>DeltaV_NamerSpacePoi</defName>
    <include>
      <li>TribalWordUtility</li>
      <li>OutlanderPlaceNameUtility</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_name(p=2)->The [narrative_name] [poi_type]</li>
        <li>r_name(p=1)->[narrative_name] [poi_type]</li>
        <li>r_name(p=0.5)->[storyname] [poi_type]</li>
        <li>r_name(p=0.2)->[Color] [greekmyth_noun] [poi_type]</li>

        <li>narrative_name->[AdjectiveNatural] [thing_badass]</li>
        <li>narrative_name->[AdjectiveLarge] [thing_badass]</li>
        <li>narrative_name->[Direction] [thing_badass]</li>
        <li>narrative_name(p=0.5)->[thing_badass]</li>

        <li>thing_badass->triumph</li>
        <li>thing_badass->victory</li>
        <li>thing_badass->revenge</li>
        <li>thing_badass->agony</li>
        <li>thing_badass->torment</li>
        <li>thing_badass->vengeance</li>
        <li>thing_badass->anguish</li>
        <li>thing_badass->misery</li>
        <li>thing_badass->tyranny</li>
        <li>thing_badass->terror</li>
        <li>thing_badass->chaos</li>
        <li>thing_badass->anarchy</li>
        <li>thing_badass->reckoning</li>
        <li>thing_badass->defiance</li>
        <li>thing_badass->harbinger</li>
        <li>thing_badass->exile</li>

        <li>storyname(p=50)->[subject]'s [story_result]</li>
        <li>storyname(p=2)->[subject]'s [BodyPart]</li>

        <li>subject(p=5)->[NamePerson]</li>
        <li>subject->[Animal]</li>
        <li>subject->[WordTribal]</li>
        <li>subject->[PlaceOutlander]</li>

        <li>story_result->joy</li>
        <li>story_result->delight</li>
        <li>story_result->wonder</li>
        <li>story_result->pride</li>
        <li>story_result->jewel</li>
        <li>story_result->prize</li>
        <li>story_result->bounty</li>
        <li>story_result->honor</li>
        <li>story_result->jackpot</li>
        <li>story_result->trophy</li>
        <li>story_result->destruction</li>
        <li>story_result->cataclysm</li>
        <li>story_result->ruin</li>
        <li>story_result->deception</li>
        <li>story_result->facade</li>
        <li>story_result->fraud</li>

        <li>greekmyth_noun->odyssey</li>
        <li>greekmyth_noun->athena</li>
        <li>greekmyth_noun->poseidon</li>
        <li>greekmyth_noun->scylla</li>
        <li>greekmyth_noun->hermes</li>
        <li>greekmyth_noun->argonaut</li>
        <li>greekmyth_noun->helios</li>
        <li>greekmyth_noun->achilles</li>
        <li>greekmyth_noun->siren</li>
        <li>greekmyth_noun->cyclops</li>
        <li>greekmyth_noun->medusa</li>
        <li>greekmyth_noun->gorgon</li>
        <li>greekmyth_noun->icarus</li>
        <li>greekmyth_noun->orion</li>
        <li>greekmyth_noun->lyra</li>
        <li>greekmyth_noun->vega</li>
        <li>greekmyth_noun->rigel</li>
        <li>greekmyth_noun->polaris</li>
        <li>greekmyth_noun->antares</li>
        <li>greekmyth_noun->deneb</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
</Defs>
