<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		宿主地图的 WorldObject：普通 MapParent（非 PocketMapParent），由
		GetOrGenerateMapUtility.GetOrGenerateMap 在轨道层 tile 上创建并挂载地图。
		飞船口袋图的 PocketMapParent.sourceMap 指向宿主图（原版"口袋图需要宿主"的
		引擎语义：storyteller 事件点数、财富统计、任务寻路都从口袋图重定向到 sourceMap）。
		阶段3 起改用 SpaceHostParent_DeltaV 子类：覆写 WorldCameraPosition，
		星球背景视角取主船连续 universe 位置（动态锚），与飞船图背景同源同步。
	-->
	<WorldObjectDef>
		<defName>DeltaV_SpaceHostParent</defName>
		<label>Delta-V space anchor</label>
		<worldObjectClass>DeltaV.SpaceHostParent_DeltaV</worldObjectClass>
		<mapGenerator>DeltaV_SpaceHost</mapGenerator>
		<texture>World/WorldObjects/RoutePlannerWaypoint</texture>
	</WorldObjectDef>

	<!--
		飞船/POI 口袋图的宿主（对应原版 PocketMap def 的最小三字段形状）。
		保留独立 def 便于按 def 识别 Delta-V 口袋图。生成时直接给 parent.Tile 设置
		宿主图附近的真实轨道层空 tile——MapInfo.Tile 由 parent 派生，Map.Tile 因此有效，
		renderWorld=true 的星球背景走原版正路。
		阶段3 起改用 ShipPocketParent_DeltaV 子类：覆写 WorldCameraPosition，
		星球背景视角按该图宇宙对象的连续 universe 位置换算（不再随 60 tick 离散
		tile 重锚跳变）。tile 不得与其他地图/世界对象重复（Game.FindMap 按 map.Tile 匹配）。
	-->
	<WorldObjectDef>
		<defName>DeltaV_ShipMapParent</defName>
		<label>pocket ship map</label> <!-- hidden -->
		<worldObjectClass>DeltaV.ShipPocketParent_DeltaV</worldObjectClass>
	</WorldObjectDef>

</Defs>
