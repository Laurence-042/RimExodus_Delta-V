<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		推进器出力上限（2026-09-27）：给原版大/小推进器追加 DeltaV.CompProperties_
		ThrusterPowerLimit——多选推进器后弹滑条统一设置出力百分比（存档事实）。
		有符号基础推力由 DefModExtension_ThrusterPower 配置；出力统一经实体适配入口。
	-->

	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="SmallThruster"]</xpath>
		<value><li Class="DeltaV.DefModExtension_ThrusterPower"><thrust>800</thrust></li></value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="LargeThruster"]</xpath>
		<value><li Class="DeltaV.DefModExtension_ThrusterPower"><thrust>2000</thrust></li></value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="LargeThruster"]/comps</xpath>
		<value>
			<li Class="DeltaV.CompProperties_ThrusterPowerLimit" />
			<li Class="DeltaV.CompProperties_ThrusterVisuals"><exhaust><smokeSize>0.9</smokeSize><smokeLifetime>165</smokeLifetime></exhaust></li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="SmallThruster"]/comps</xpath>
		<value>
			<li Class="DeltaV.CompProperties_ThrusterPowerLimit" />
			<li Class="DeltaV.CompProperties_ThrusterVisuals"><exhaust><smokeSize>0.65</smokeSize><smokeLifetime>135</smokeLifetime></exhaust></li>
		</value>
	</Operation>

</Patch>
