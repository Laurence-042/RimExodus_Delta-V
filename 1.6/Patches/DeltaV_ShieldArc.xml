<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		阶段5 段5：给原版护盾发生器追加太空侧弧参数（CompSpaceShieldArc）。
		弧几何是派生缓存（随容器姿态旋转），容量事实驻留原版 comp——本 patch 只加
		参数，不改原版同图战斗机制。弧跨默认 120°、朝向默认北（90°，地图帧）。
	-->

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="GravshipShieldGenerator"]/comps</xpath>
		<value>
			<li Class="DeltaV.CompProperties_SpaceShieldArc">
				<arcSpanDeg>120</arcSpanDeg>
				<arcFacingDeg>90</arcFacingDeg>
			</li>
		</value>
	</Operation>

</Patch>
